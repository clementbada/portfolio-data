# Copier en .env pour un lancement local (jamais commité).
# En production, ces valeurs sont des secrets GitHub du dépôt :
# Settings → Secrets and variables → Actions → New repository secret.

# FRED (St. Louis Fed) — 10 ans US quotidien. Clé gratuite :
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# MarketAux — actualités reliées aux tickers du portefeuille. Clé gratuite (100 requêtes/jour) :
# https://www.marketaux.com/register
MARKETAUX_API_KEY=
